# CatCare BD environment template. Copy to `.env` and fill real values locally.
# `.env` is git-ignored.

# Build flavor. Set via `--dart-define=FLAVOR=dev` at run/build time. The
# AppEnv loader falls back to `dev` when not provided.
FLAVOR=dev

# Google Maps + Places (used by Phase 6). Final production key must live in a
# Cloud Function, not in this file. See docs/architecture.md "AI Architecture".
GOOGLE_MAPS_API_KEY=replace_me
GOOGLE_PLACES_API_KEY=replace_me

# Firebase Cloud Messaging project (Phase 8).
FCM_PROJECT_ID=replace_me

# Firebase project IDs (one per flavor). Empty placeholders; populate via
# `flutterfire configure` and the Flutter project console.
FIREBASE_PROJECT_ID=catcare-dev
FIREBASE_PROJECT_ID_STAGING=catcare-staging
FIREBASE_PROJECT_ID_PROD=catcare-prod