/android/app/release

# Local-only secrets and per-developer environment overrides.
# Firebase client configuration files (`lib/firebase_options.dart`,
# `android/app/google-services.json`, `ios/Runner/GoogleService-Info.plist`)
# are NOT secrets — they contain public identifiers (project id, app id,
# Firebase API keys) that ship inside every Firebase SDK distribution. They
# are committed so that CI, fresh checkouts, and new contributors can build
# without running `flutterfire configure` first. See docs/architecture.md
# "Firebase client configuration" for the rationale.
.env
**/.env

# Generated localization files
lib/l10n/app_localizations.dart

# Build artifacts
.puku/

# Auto-generated plugin registrant files are produced by `flutter pub get`
# and should not be committed.
**/GeneratedPluginRegistrant.swift
**/GeneratedPluginRegistrant.h
**/GeneratedPluginRegistrant.m
**/GeneratedPluginRegistrant.cs
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.kt
